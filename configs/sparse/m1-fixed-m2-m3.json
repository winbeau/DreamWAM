{
  "prompt_cache": {"capacity": 8},
  "hybrid_visual": {
    "schema_version": 1,
    "schedule": {
      "kind": "explicit", "num_steps": 10,
      "operations": ["dense", "reuse", "reuse", "reuse", "reuse", "sparse", "reuse", "reuse", "reuse", "reuse"]
    },
    "recompute": {"keep_ratio": 0.2},
    "read": {"mode": "compact", "keep_ratio": 0.5},
    "selection": {
      "method": "action_context", "guidance_weight": 1.0, "frame_quota": "balanced",
      "context_weight": 1.0, "support_seed_ratio": 0.1
    },
    "reuse": {"mode": "features"},
    "execution": {"backend": "cuda_graph", "graph_warmup": 3, "max_graphs": 8},
    "diagnostics": {"level": "counters"}
  },
  "chunk_budget": {
    "schema_version": 1,
    "mode": "adaptive", "fixed_level": 1,
    "levels": [
      {"name": "low", "query_ratio": 0.1, "read_ratio": 0.25},
      {"name": "medium", "query_ratio": 0.2, "read_ratio": 0.5},
      {"name": "high", "query_ratio": 0.3, "read_ratio": 0.75}
    ],
    "thresholds": [0.5, 1.5],
    "scales": {
      "rgb_change": 0.08, "rgb_innovation": 0.08,
      "translation": 0.05, "rotation": 0.3, "gripper": 0.02,
      "translation_innovation": 0.05
    },
    "history_size": 3, "thumbnail_size": 32, "downshift_after": 2
  }
}
